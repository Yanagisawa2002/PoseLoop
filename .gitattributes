* text=auto
*.py text eol=lf
*.sh text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.mp4 filter=lfs diff=lfs merge=lfs -text

# Preserve byte-stable v1.2 evidence text across Windows/Linux checkouts.
reports/v12_repro_5090/** text eol=lf
# Preserve exact CSV artifact bytes, including the original writer's CRLF.
reports/v12_repro_5090/a9-v11-replay/**/*.csv -text whitespace=cr-at-eol
reports/v12_repro_5090/a9-v11-replay/*.csv -text whitespace=cr-at-eol
