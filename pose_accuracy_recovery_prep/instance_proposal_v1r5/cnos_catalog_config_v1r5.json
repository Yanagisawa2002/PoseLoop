    ],
    "frame_proposal_order": [
      "proposal_score_desc",
      "mask_stability_desc",
      "proposal_index_asc"
    ],
    "frame_selected_mask_order": [
      "selected_cad_similarity_desc",
      "proposal_score_desc",
      "mask_stability_desc",
      "proposal_index_asc"
    ],
    "top_k_objects": 5,
    "runtime_target_object_id_input_permitted": false,
    "gt_association_permitted": false
  },
  "postprocessing": {
    "confidence_filter": null,
    "min_box_side_relative": 0.05,
    "min_mask_area_relative": 0.0003,
    "nms": null,
    "proposal_policy": "all_post_geometric_filter_independent_instance_masks"
  },
  "oom_policy": {
    "formula_changes_permitted": false,
    "initial_proposal_chunk_size": 16,
    "max_chunk_reductions": 4,
    "minimum_proposal_chunk_size": 1,
    "reduction": "integer_halve_retry_same_slice"
  }
}
