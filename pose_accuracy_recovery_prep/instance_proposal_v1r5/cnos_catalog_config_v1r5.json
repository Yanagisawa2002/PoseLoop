{
  "schema_version": "poseloop.pose-accuracy-recovery.cnos-catalog-adapter.v1r5",
  "route": "OFFICIAL_CNOS_FASTSAM_X_DINOV2_VITL14_ALL_CAD_CATALOG",
  "frame_size": {
    "height": 1080,
    "width": 1440
  },
  "fastsam": {
    "architecture": "FastSAM-x",
    "configured_conf_threshold": 0.05,
    "effective_wrapper_conf_threshold": 0.25,
    "iou_threshold": 0.9,
    "mask_threshold": 0.5,
    "max_det": 200,
    "segmentor_width_size": 640,
    "stability_high_threshold": 0.55,
    "stability_low_threshold": 0.5
  },
  "dinov2": {
    "architecture": "ViT-L/14",
    "descriptor_width_size": 640,
    "feature_chunk_size": 16,
    "model_name": "dinov2_vitl14",
    "normalize_features": true,
    "proposal_image_size": 224,
    "score_storage_transform": "raw_cosine_plus_one_divide_two_without_clamp",
    "template_aggregation": "average_top_5_cosine",
    "token_name": "x_norm_clstoken"
